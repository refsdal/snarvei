{
  "name": "snarvei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "wrangler deploy",
    "build:dev": "tsc -b && CLOUDFLARE_ENV=dev vite build",
    "deploy:dev": "CLOUDFLARE_ENV=dev wrangler deploy --env dev",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "check:dev": "tsc -b && CLOUDFLARE_ENV=dev vite build && CLOUDFLARE_ENV=dev wrangler deploy --dry-run --env dev",
    "lint": "eslint .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate --name drift-check && git diff --exit-code --stat src/worker/db/migrations && echo 'migrations are in sync with schema.ts'",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/zod-openapi": "^1.6.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.12.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@scalar/api-reference": "1.67.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  }
}
